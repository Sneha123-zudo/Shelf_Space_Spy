APP_NAME=Shelf Space Spy API
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
SERPAPI_API_KEY=
JWT_SECRET=change-this-demo-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_USER_EMAIL=demo@shelfspacespy.com
DEMO_USER_PASSWORD=Demo@123
DEMO_USER_NAME=Demo Brand Owner
DEMO_MARKET_NAME=Indian Skincare
DEMO_MARKET_COUNTRY=IN
DEMO_MARKET_CATEGORY=Skincare
DEMO_BRAND_NAME=Minimalist
DEMO_MARKET_KEYWORDS=vitamin c serum,niacinamide serum,tinted sunscreen
DEMO_COMPETITORS=The Derma Co,Dot & Key,Plum,Mamaearth
# Optional second example market from a different category (leave DEMO_MARKET_2_NAME empty to skip).
DEMO_MARKET_2_NAME=US Espresso Machines
DEMO_MARKET_2_COUNTRY=US
DEMO_MARKET_2_CATEGORY=Espresso Machines
DEMO_MARKET_2_BRAND=Breville
DEMO_MARKET_2_KEYWORDS=espresso machine,coffee grinder,milk frother
DEMO_MARKET_2_COMPETITORS=De'Longhi,Nespresso,Keurig,Gaggia
# Optional: enables LLM narration of the weekly brief (template fallback otherwise).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Refuse a new live scan if the last one is younger than this, unless force=true.
SCAN_MIN_INTERVAL_MINUTES=60
# Hard daily cap on live SerpAPI credits across all markets (UTC day); 0 disables. `force` cannot bypass it.
DAILY_CREDIT_BUDGET=50
# Cancel a background scan that runs longer than this.
SCAN_JOB_TIMEOUT_SECONDS=600
# Cached Google autocomplete/shopping responses used by market suggestions stay valid this long.
SUGGEST_CACHE_TTL_HOURS=168
# Google Trends window; 12 months is the default (use "today 5-y" for year-over-year comparisons).
TRENDS_DATE_RANGE=today 12-m
# Where SerpAPI responses are cached; empty means backend/data/serpapi_cache.
SERPAPI_CACHE_DIR=
# Retries for SerpAPI rate limits / 5xx (bounded exponential backoff). Quota and key errors are never retried.
SERPAPI_MAX_ATTEMPTS=3
SERPAPI_BACKOFF_BASE_SECONDS=1.0
SERPAPI_BACKOFF_CAP_SECONDS=20.0
# text for people, json for log collectors
LOG_LEVEL=INFO
LOG_FORMAT=text
